# Server
NODE_ENV=development
PORT=4000
# Public site URL (used in health/logs; optional but recommended in production)
# APP_URL=https://your-domain.com

# MongoDB Atlas (required — local fallback to 127.0.0.1 is disabled)
# Use either name (Hostinger guides sometimes say MONGODB_URI):
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/society-management?retryWrites=true&w=majority
# MONGODB_URI=
# Session security (REQUIRED in production — use a long random string)
SESSION_SECRET=change-this-to-a-random-secret

# Set to 1 if TLS is terminated by a reverse proxy (Hostinger Node apps usually need this)
TRUST_PROXY=1

# Optional: bump to force clients to reload CSS/JS after a deploy
# ASSET_VERSION=20260727

# Brute-force / lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MS=86400000
PASSWORD_OTP_TTL_MS=1800000

# Seeded control accounts (change passwords after first login in production)
DEVELOPER_EMAIL=developer@societyhub.local
DEVELOPER_PASSWORD=devSecure2003
# CEO_EMAIL=
# CEO_PASSWORD=
# MEMBER_EMAIL=
# MEMBER_PASSWORD=

# Email / SMTP (recommended in production for receipts + OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_FROM=SocietyHub <no-reply@your-domain.com>
ADMIN_ALERT_EMAIL=

# SMS / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_ALERT_PHONE=

# Automatic dividend weights
DIVIDEND_SAVINGS_WEIGHT=0.6
DIVIDEND_PROFIT_WEIGHT=0.4

# Optional fallback if no per-month target is saved in the UI
MONTHLY_CONTRIBUTION=
